---
import "./styles.css";

const pillars = [
  {
    num: "01",
    tag: "Agentic Systems",
    title: "Multi-Agent Architectures",
    body: "Building autonomous, tool-using AI agents that plan, reason, and execute complex multi-step workflows — with state persistence, fallback loops, and deterministic execution.",
  },
  {
    num: "02",
    tag: "Full-Stack Web",
    title: "End-to-End Applications",
    body: "Crafting complete production applications — from database schemas and fast API endpoints down to responsive, high-performance user interfaces.",
  },
  {
    num: "03",
    tag: "AI Infrastructure",
    title: "RAG & LLM Integration",
    body: "Connecting LLMs to enterprise data using hybrid retrieval, vector search, function calling, and structured outputs for reliable software systems.",
  },
];
---
<section class="pillars" id="pillars">
  <div class="pillars-header" data-reveal>
    <p class="mono eyebrow">Core Capabilities</p>
    <h2 class="display">What I Build</h2>
  </div>
  <div class="pillar-grid">
    {pillars.map((p, i) => (
      <div class="pillar-card" data-reveal data-reveal-delay={Math.min(i + 1, 3)}>
        <div class="pillar-top">
          <span class="pillar-num mono">{p.num}</span>
          <span class="pillar-tag mono">{p.tag}</span>
        </div>
        <h3 class="pillar-title">{p.title}</h3>
        <p class="pillar-body">{p.body}</p>
      </div>
    ))}
  </div>
</section>
