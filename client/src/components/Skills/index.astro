---
import "./styles.css";

const skillCategories = [
  {
    title: "AI & Agentic Systems",
    icon: "🤖",
    description: "Autonomous agents, LLM apps & RAG pipelines",
    skills: [
      "Python",
      "LangGraph",
      "LangChain",
      "CrewAI",
      "MCP Protocol",
      "RAG Pipelines",
      "Vector DBs (Chroma)",
      "LLM APIs (Claude, OpenAI)",
      "Agentic Tooling",
    ],
  },
  {
    title: "Full-Stack Engineering",
    icon: "🌐",
    description: "Modern web frontends, backend APIs & WebSockets",
    skills: [
      "TypeScript",
      "JavaScript",
      "React.js",
      "Node.js",
      "FastAPI",
      "Express.js",
      "Tailwind CSS",
      "WebSockets",
      "Vite",
    ],
  },
  {
    title: "Cloud & DevOps",
    icon: "☁️",
    description: "Containerization, CI/CD pipelines & cloud hosting",
    skills: [
      "Docker",
      "AWS",
      "GitHub Actions",
      "Nginx",
      "Vercel",
      "Render",
      "Git & GitHub",
    ],
  },
  {
    title: "Databases & Data",
    icon: "📊",
    description: "Relational & NoSQL databases, analytics & automation",
    skills: [
      "PostgreSQL",
      "MongoDB",
      "Supabase",
      "n8n Workflows",
      "Pandas & NumPy",
      "Scikit-learn",
      "Twilio API",
    ],
  },
];
---
<section class="skills" id="skills" data-reveal>
  <p class="mono eyebrow">Tech Stack</p>
  <h2 class="display">Stack I use to ship</h2>
  <div class="skill-grid">
    {skillCategories.map((category) => (
      <div class="skill-card">
        <div class="card-header">
          <span class="category-icon">{category.icon}</span>
          <div>
            <h3>{category.title}</h3>
            <p class="category-desc">{category.description}</p>
          </div>
        </div>
        <ul class="skills-list">
          {category.skills.map((skill) => (
            <li class="skill-pill">{skill}</li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>
