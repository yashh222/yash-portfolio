
---
import { projects } from "../../data/content.js";
import "./styles.css";
---

<section class="work" id="work">
  <div class="work-header">
    <p class="mono eyebrow" data-reveal>Selected Work</p>
    <h2 class="display" data-reveal>
      Things I've<br />shipped
    </h2>
    <p class="work-description" data-reveal>
      A collection of agentic AI platforms, fullstack web products, and developer tooling built with production engineering standards.
    </p>

    <div class="work-filters" role="tablist" aria-label="Filter projects">
      <button type="button" class="work-filter active" data-filter="ALL" aria-selected="true">All</button>
      <button type="button" class="work-filter" data-filter="DYNAMIC" aria-selected="false">Agentic AI</button>
      <button type="button" class="work-filter" data-filter="RESPONSIVE" aria-selected="false">Fullstack & Tools</button>
    </div>
  </div>

  <div class="work-list">
    {projects.map((p, i) => (
      <article
        class="work-card"
        data-category={p.category}
        data-reveal
        data-reveal-delay={Math.min(i, 3)}
      >
        <!-- LEFT: Identity -->
        <div class="wc-identity">
          <span class="project-index mono">0{i + 1}</span>
          <h3 class="project-title">{p.title}</h3>
          <p class="project-desc">{p.pitch}</p>
          <div class="project-stack">
            {p.stack.map((tech) => (
              <span class="tech-pill">{tech}</span>
            ))}
          </div>
        </div>

        <!-- RIGHT: Proof -->
        <div class="wc-proof">
          <div class="proof-header">
            <span class="proof-highlight">{p.outcome}</span>
            <a href={`/projects/${p.slug}`} class="case-study-link">
              View Case Study <span class="arrow">↗</span>
            </a>
          </div>
          <div class="proof-preview">
            <img src={p.gallery[0].src} alt={p.gallery[0].alt} loading="lazy" />
          </div>
        </div>
      </article>
    ))}
  </div>
</section>

<script>
  const filterButtons = document.querySelectorAll(".work-filter");
  const projectCards = document.querySelectorAll(".work-card");

  filterButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const selectedCategory = button.dataset.filter;

      filterButtons.forEach((btn) => {
        const isActive = btn === button;

        btn.classList.toggle("active", isActive);
        btn.setAttribute("aria-selected", String(isActive));
      });

      projectCards.forEach((card) => {
        const cardCategory = card.dataset.category;

        const shouldShow =
          selectedCategory === "ALL" ||
          cardCategory === selectedCategory;

        card.hidden = !shouldShow;
      });
    });
  });
</script>